# Local development. Copy to .env; never commit the populated file.
# Replace both placeholders before starting services. Generate JWT_SECRET locally.
POSTGRES_USER=mlq_admin
POSTGRES_PASSWORD=replace_with_strong_local_password
POSTGRES_DB=matchlambda
JWT_SECRET=replace_with_random_32_byte_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REDIS_URL=redis://redis:6379/0

# Blank keys disable integrations; source/merchant acceptance gates still apply.
THE_ODDS_API_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Set to an actual public HTTPS /v1/payments/webhook endpoint when testing IPN.
NOWPAYMENTS_IPN_CALLBACK_URL=

# Browser-visible local URLs; backend uses the app URL as its allowed origin.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
