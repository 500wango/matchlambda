# Node
node_modules/
.next/
out/
# Generated and rewritten by `next dev` / `next build` / `next typegen`, which
# swap the `.next/dev/types` and `.next/types` imports back and forth. Next
# manages its contents and documents it as gitignored:
# https://nextjs.org/docs/app/api-reference/config/typescript
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Database & local data
*.sqlite3
postgres_data/
# deploy/backup.sh writes dumps here by default. A database dump must never be
# committed: it carries password hashes and every user row.
backups/
data/historical/
backend/data/
celerybeat-schedule
*.pid
*.log

# IDE & OS
.vscode/
.idea/
.DS_Store
*.swp
*~
*.tsbuildinfo

# Local agent/tooling state
.reasonix/
reasonix.toml

# Code-review reports stay local. They name reproducible exploits and list
# weaknesses that are still unfixed, so they are not published with the source.
docs/CODE_REVIEW_REPORT*.md
