# Production environment for docker-compose.prod.yml.
#
#   cp deploy/env.prod.example .env      # repo root, which .gitignore covers
#
# Every CHANGE_ME / example.com value must be replaced. The compose file uses
# `${VAR:?message}` for required values, so a missing one fails the start with
# that message instead of booting a half-configured service.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=mlq_admin
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
POSTGRES_DB=matchlambda

# --- Auth -----------------------------------------------------------------
# Generate with:  openssl rand -base64 48
# Required: the app refuses to start without it (an empty secret would let
# anyone forge tokens).
JWT_SECRET=CHANGE_ME_openssl_rand_base64_48
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Public hostnames -----------------------------------------------------
# DOMAIN hosts the API. Caddy fetches a Let's Encrypt certificate for it, so an
# A record must already point here BEFORE the first `up`: every failed ACME
# challenge counts against Let's Encrypt rate limits.
# The payment provider's IPN callback becomes https://$DOMAIN/v1/payments/webhook
DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Origin of the Cloudflare Pages site. This is the ONLY credentialed CORS
# origin in production, so a wrong value breaks the browser app while leaving
# curl and the payment webhook working — an easy mistake to misdiagnose.
APP_ORIGIN=https://app.example.com

# --- Internal networking --------------------------------------------------
# Caddy reaches the api over this compose network. TRUSTED_PROXY_CIDRS is set
# from the same value in the compose file, so change it in one place.
COMPOSE_SUBNET=172.28.0.0/24
REDIS_URL=redis://redis:6379/0

# --- Abuse limits (defaults live in docker-compose.prod.yml) ---------------
# TRIAL_MAX_PER_IP_PER_DAY=3
# WEBHOOK_MAX_BODY_BYTES=65536

# --- Integrations ---------------------------------------------------------
# A blank key disables the integration; the app degrades rather than failing to
# start. Source-eligibility and merchant-acceptance gates still apply.
THE_ODDS_API_KEY=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=https://api.example.com/v1/payments/webhook
# Mocks provider calls and skips the reconciliation lookup. Testing only —
# never true in production.
PAYMENTS_SANDBOX_MODE=false

# --- Backups (used by deploy/backup.sh, not by the app) -------------------
# rclone remote for off-host copies, e.g. r2:matchlambda-backups
# R2_REMOTE=
BACKUP_KEEP=7

# --- First administrator --------------------------------------------------
# Used once, and only while the database has zero administrators. Leave unset
# for a normal install.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
